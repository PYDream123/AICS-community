# 数据库（与 docker-compose.yml 保持一致）
DB_URL=jdbc:postgresql://localhost:5432/aics
DB_USER=aics
DB_PASSWORD=aics

# 对话模型：DeepSeek 官方 API（只提供对话，没有 Embedding 接口）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 向量模型：任一 OpenAI 兼容 Embedding 服务（默认硅基流动 bge-m3，1024 维）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
